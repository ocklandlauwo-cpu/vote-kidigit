# dependencies
node_modules/

# builds and test output
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# environment and secrets — only .env.example files are committed
.env
.env.*
!.env.example

# Inter fonts copied from packages/shared/src/design/fonts by the design-system Vite plugin
apps/*/public/fonts/

# generated Prisma client (prisma generate runs before build, typecheck and test)
apps/api/src/generated/

# local storage (uploads, generated reports)
storage/

# logs
*.log
logs/

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Original Word specs and private notes (incl. credentials). docs/*.md is the source of truth.
Documentations/
~$*
*.tmp

# Load test data (scripts/load): the seed holds every voter's code.
load-seed*.json
load-report*.json
