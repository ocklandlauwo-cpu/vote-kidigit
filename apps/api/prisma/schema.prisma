// Vote-Kidigit database schema (Backend Schema). Tables arrive from step 7 on;
// RLS policies, functions, triggers and grants live as SQL in the same migrations.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // Partial unique indexes (… WHERE deleted_at IS NULL) for soft-deleted tables.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "ballot", "audit"]
}

// -----------------------------------------------------------------------------------------------
// Tenancy, identity and access (Backend Schema 4). Not expressible here and added as SQL in
// migration 003: CHECK constraints, the generated users.email_normalized column, triggers,
// RLS policies, grants and app.create_default_roles(). Child tables carry organization_id and
// reference their parent through composite foreign keys (parent id + organization_id), so a
// row can never claim a different organization than its parent.
// -----------------------------------------------------------------------------------------------

model Organization {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String
  slug                  String
  logoFileId            String?   @map("logo_file_id") @db.Uuid
  primaryColor          String?   @map("primary_color") @db.Char(7)
  timeZone              String    @default("Africa/Dar_es_Salaam") @map("time_zone")
  contactEmail          String?   @map("contact_email")
  contactPhone          String?   @map("contact_phone")
  smsSenderId           String?   @map("sms_sender_id")
  helpPhone             String?   @map("help_phone")
  sessionTimeoutMinutes Int       @default(15) @map("session_timeout_minutes") @db.SmallInt
  archiveAfterDays      Int       @default(90) @map("archive_after_days")
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at") @db.Timestamptz(6)
  status                OrgStatus @default(active)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  users           User[]
  roles           Role[]
  passwordHistory PasswordHistory[]
  userTokens      UserToken[]
  votingEvents    VotingEvent[]
  files           File[]
  logoFile        File?             @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  @@unique([slug], map: "organizations_slug_key", where: raw("deleted_at IS NULL"))
  @@map("organizations")
  @@schema("public")
}

model User {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// NULL only for Platform Super Admins.
  organizationId    String?    @map("organization_id") @db.Uuid
  email             String
  /// Generated column lower(trim(email)); never written by the application.
  emailNormalized   String     @default(dbgenerated()) @map("email_normalized")
  fullName          String     @map("full_name")
  phone             String?
  passwordHash      String?    @map("password_hash")
  status            UserStatus @default(invited)
  isPlatformAdmin   Boolean    @default(false) @map("is_platform_admin")
  isOrgSuperAdmin   Boolean    @default(false) @map("is_org_super_admin")
  language          String     @default("sw")
  themePreference   String     @default("system") @map("theme_preference")
  failedLoginCount  Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  /// Last wrong password; failure counts older than 24 h start again (same window as unknown emails).
  lastFailedLoginAt DateTime?  @map("last_failed_login_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  passwordHistory    PasswordHistory[]
  tokens             UserToken[]       @relation("UserTokenOwner")
  tokensCreated      UserToken[]       @relation("UserTokenCreator")
  /// At most one in V1: user_roles.user_id is unique.
  userRoles          UserRole[]
  eventsCreated      VotingEvent[]     @relation("EventCreator")
  eventAssignments   EventAssignment[] @relation("AssignedUser")
  assignmentsCreated EventAssignment[] @relation("AssignmentCreator")
  filesCreated       File[]            @relation("FileCreator")
  importsCreated     VoterImport[]     @relation("ImportCreator")
  batchesCreated     SmsBatch[]        @relation("BatchCreator")
  kiosksLaunched     KioskSession[]    @relation("KioskLauncher")
  kiosksEnded        KioskSession[]    @relation("KioskEnder")

  @@unique([emailNormalized], map: "users_email_normalized_key", where: raw("deleted_at IS NULL"))
  /// Target of composite foreign keys from organization-owned child tables.
  @@unique([id, organizationId], map: "users_id_organization_id_key")
  @@index([organizationId])
  @@map("users")
  @@schema("public")
}

model PasswordHistory {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Copied from the user by trigger, for RLS.
  organizationId String?  @map("organization_id") @db.Uuid
  passwordHash   String   @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("password_history")
  @@schema("public")
}

model UserToken {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Copied from the user by trigger, for RLS.
  organizationId String?   @map("organization_id") @db.Uuid
  /// invite | password_reset
  purpose        String
  /// SHA-256 of the random 32-byte token sent by email.
  tokenHash      Bytes     @unique(map: "user_tokens_token_hash_key") @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User          @relation("UserTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  creator      User?         @relation("UserTokenCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdBy])
  @@index([organizationId])
  @@map("user_tokens")
  @@schema("public")
}

/// Global permission catalogue (Backend Schema 9.1), seeded by migration; read-only for vk_api.
// -----------------------------------------------------------------------------------------------
// Events, categories, contesters and voters (Backend Schema 4.9, 5). Not expressible here and
// added as SQL in migration 011: CHECK constraints, the generated
// voters.membership_id_normalized column, the deferrable unique display order, the setup-lock
// and window triggers (11.2), app.transition_event() (11.5), app.publish_checklist(),
// app.category_is_votable(), app.voter_is_eligible(), RLS and grants.
// -----------------------------------------------------------------------------------------------

model VotingEvent {
  id                         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId             String            @map("organization_id") @db.Uuid
  name                       String
  startAt                    DateTime          @map("start_at") @db.Timestamptz(6)
  endAt                      DateTime          @map("end_at") @db.Timestamptz(6)
  /// Changes only through app.transition_event() (Backend Schema 11.5).
  status                     EventStatus       @default(draft)
  isActive                   Boolean           @default(true) @map("is_active")
  showParty                  Boolean           @default(false) @map("show_party")
  resultsVisibility          ResultsVisibility @default(full) @map("results_visibility")
  reminderBeforeOpenHours    Int?              @default(24) @map("reminder_before_open_hours") @db.SmallInt
  reminderBeforeCloseMinutes Int?              @default(60) @map("reminder_before_close_minutes") @db.SmallInt
  publicResultsToken         String?           @map("public_results_token")
  publicResultsEnabled       Boolean           @default(true) @map("public_results_enabled")
  firstCodeSentAt            DateTime?         @map("first_code_sent_at") @db.Timestamptz(6)
  openedAt                   DateTime?         @map("opened_at") @db.Timestamptz(6)
  closedAt                   DateTime?         @map("closed_at") @db.Timestamptz(6)
  resultsPublishedAt         DateTime?         @map("results_published_at") @db.Timestamptz(6)
  cancelledAt                DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  archivedAt                 DateTime?         @map("archived_at") @db.Timestamptz(6)
  cancelReason               String?           @map("cancel_reason")
  reopenCount                Int               @default(0) @map("reopen_count") @db.SmallInt
  createdBy                  String?           @map("created_by") @db.Uuid
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator        User?             @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments    EventAssignment[]
  categories     Category[]
  voters         Voter[]
  voterImports   VoterImport[]
  smsTemplates   SmsTemplate[]
  smsBatches     SmsBatch[]
  smsMessages    SmsMessage[]
  ballots        Ballot[]
  kioskSessions  KioskSession[]
  kioskCodeSends KioskCodeSend[]

  @@unique([publicResultsToken], map: "voting_events_public_results_token_key")
  /// Target of composite foreign keys from the event's children.
  @@unique([id, organizationId], map: "voting_events_id_organization_id_key")
  @@index([organizationId, status])
  @@index([createdBy])
  @@map("voting_events")
  @@schema("public")
}

model EventAssignment {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  type           AssignmentType
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  event   VotingEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user    User        @relation("AssignedUser", fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  creator User?       @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([eventId, userId], map: "event_assignments_event_id_user_id_key")
  @@index([userId])
  @@index([organizationId])
  @@index([createdBy])
  @@map("event_assignments")
  @@schema("public")
}

model Category {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  name           String
  pictureFileId  String?             @map("picture_file_id") @db.Uuid
  /// Unique per event; the constraint is DEFERRABLE (migration 011) so reordering can swap.
  displayOrder   Int                 @map("display_order")
  isActive       Boolean             @default(true) @map("is_active")
  opensAt        DateTime?           @map("opens_at") @db.Timestamptz(6)
  closesAt       DateTime?           @map("closes_at") @db.Timestamptz(6)
  manualState    CategoryManualState @default(auto) @map("manual_state")
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(6)
  selectionMode  SelectionMode       @default(exact) @map("selection_mode")
  exactCount     Int?                @default(1) @map("exact_count") @db.SmallInt
  minCount       Int?                @map("min_count") @db.SmallInt
  maxCount       Int?                @map("max_count") @db.SmallInt
  seats          Int                 @default(1) @db.SmallInt
  allowSkip      Boolean             @default(false) @map("allow_skip")
  winnerRule     WinnerRule          @default(plurality) @map("winner_rule")
  thresholdPct   Decimal?            @map("threshold_pct") @db.Decimal(5, 2)
  quorumPct      Decimal?            @map("quorum_pct") @db.Decimal(5, 2)
  eligibility    EligibilityMode     @default(all)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  event            VotingEvent          @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  picture          File?                @relation("CategoryPicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  contesters       Contester[]
  voters           CategoryVoter[]
  participation    VoterParticipation[]
  ballotSelections BallotSelection[]

  @@unique([eventId, name], map: "categories_event_id_name_key")
  @@unique([eventId, displayOrder], map: "categories_event_id_display_order_key")
  /// Targets of composite foreign keys from contesters and category_voters.
  @@unique([id, eventId, organizationId], map: "categories_id_event_id_organization_id_key")
  @@unique([id, organizationId], map: "categories_id_organization_id_key")
  @@index([organizationId])
  @@map("categories")
  @@schema("public")
}

model Contester {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  /// Equal to the category's event (composite foreign key).
  eventId        String          @map("event_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  fullName       String          @map("full_name")
  party          String?
  photoFileId    String?         @map("photo_file_id") @db.Uuid
  ussdShortName  String?         @map("ussd_short_name")
  status         ContesterStatus @default(active)
  withdrawnAt    DateTime?       @map("withdrawn_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  category         Category          @relation(fields: [categoryId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  photo            File?             @relation("ContesterPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  ballotSelections BallotSelection[]

  @@index([categoryId])
  @@index([eventId])
  @@index([organizationId])
  @@map("contesters")
  @@schema("public")
}

model Voter {
  id                     String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId         String     @map("organization_id") @db.Uuid
  eventId                String     @map("event_id") @db.Uuid
  fullName               String     @map("full_name")
  membershipId           String     @map("membership_id")
  /// Generated column upper(regexp_replace(membership_id, '\s', '', 'g')); never written.
  membershipIdNormalized String     @default(dbgenerated()) @map("membership_id_normalized")
  phone                  String
  email                  String?
  gender                 Gender
  photoFileId            String?    @map("photo_file_id") @db.Uuid
  /// HMAC-SHA256 of the normalized code (Backend Schema 5.4); hidden from vk_readonly.
  codeHmac               Bytes?     @map("code_hmac")
  /// AES-256-GCM copy of the code for re-sending; only the SMS worker decrypts it.
  codeCiphertext         Bytes?     @map("code_ciphertext")
  codeStatus             CodeStatus @default(not_sent) @map("code_status")
  codeGeneratedAt        DateTime?  @map("code_generated_at") @db.Timestamptz(6)
  codeLastSentAt         DateTime?  @map("code_last_sent_at") @db.Timestamptz(6)
  failedAttempts         Int        @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil            DateTime?  @map("locked_until") @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?  @map("deleted_at") @db.Timestamptz(6)

  event          VotingEvent          @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  photo          File?                @relation("VoterPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  messages       SmsMessage[]
  categories     CategoryVoter[]
  participation  VoterParticipation[]
  kioskCodeSends KioskCodeSend[]

  @@unique([eventId, membershipIdNormalized], map: "voters_event_id_membership_id_normalized_key", where: raw("deleted_at IS NULL"))
  @@unique([eventId, codeHmac], map: "voters_event_id_code_hmac_key", where: raw("code_hmac IS NOT NULL AND deleted_at IS NULL"))
  /// Target of the composite foreign key from category_voters.
  @@unique([id, organizationId], map: "voters_id_organization_id_key")
  @@index([eventId, codeStatus])
  @@index([organizationId, phone])
  @@map("voters")
  @@schema("public")
}

model CategoryVoter {
  categoryId     String   @map("category_id") @db.Uuid
  voterId        String   @map("voter_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  voter    Voter    @relation(fields: [voterId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([categoryId, voterId])
  @@index([voterId])
  @@index([organizationId])
  @@map("category_voters")
  @@schema("public")
}

/// Platform-wide settings (Backend Schema 4.10): exactly one row, id = 1. Who changed what is
/// in the audit log.
model PlatformSetting {
  id                           Int      @id @default(1) @db.SmallInt
  defaultSessionTimeoutMinutes Int      @default(15) @map("default_session_timeout_minutes") @db.SmallInt
  ussdShortCode                String?  @map("ussd_short_code")
  supportPhone                 String?  @map("support_phone")
  supportEmail                 String?  @map("support_email")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("public")
}

model Permission {
  key                  String  @id
  module               String
  descriptionEn        String  @map("description_en")
  descriptionSw        String  @map("description_sw")
  isFixedForSuperAdmin Boolean @default(false) @map("is_fixed_for_super_admin")
  /// org | event | platform
  scope                String

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("public")
}

model Role {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// org_super_admin | admin | moderator | observer for default roles; NULL for custom roles.
  systemKey      String?  @map("system_key")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name], map: "roles_organization_id_name_key")
  @@unique([organizationId, systemKey], map: "roles_organization_id_system_key_key")
  /// Target of composite foreign keys from role_permissions and user_roles.
  @@unique([id, organizationId], map: "roles_id_organization_id_key")
  @@map("roles")
  @@schema("public")
}

model RolePermission {
  roleId         String   @map("role_id") @db.Uuid
  permissionKey  String   @map("permission_key")
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@index([permissionKey])
  @@map("role_permissions")
  @@schema("public")
}

model UserRole {
  userId         String   @unique(map: "user_roles_user_id_key") @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role Role @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_roles")
  @@schema("public")
}

// -----------------------------------------------------------------------------------------------
// Enums (Backend Schema 3). PostgreSQL enums in the public schema, mirrored as Zod enums in
// packages/shared/src/constants/enums.ts; enums.spec.ts checks the three lists stay identical.
// -----------------------------------------------------------------------------------------------

enum OrgStatus {
  active
  suspended

  @@map("org_status")
  @@schema("public")
}

enum UserStatus {
  invited
  active
  deactivated

  @@map("user_status")
  @@schema("public")
}

enum AssignmentType {
  moderator
  observer

  @@map("assignment_type")
  @@schema("public")
}

enum EventStatus {
  draft
  scheduled
  open
  closed
  results_published
  cancelled
  archived

  @@map("event_status")
  @@schema("public")
}

enum ResultsVisibility {
  full
  winners_only

  @@map("results_visibility")
  @@schema("public")
}

/// auto = follow opens_at / closes_at
enum CategoryManualState {
  auto
  open
  closed

  @@map("category_manual_state")
  @@schema("public")
}

enum SelectionMode {
  exact
  range

  @@map("selection_mode")
  @@schema("public")
}

enum WinnerRule {
  plurality
  threshold

  @@map("winner_rule")
  @@schema("public")
}

enum EligibilityMode {
  all
  selected

  @@map("eligibility_mode")
  @@schema("public")
}

enum ContesterStatus {
  active
  withdrawn

  @@map("contester_status")
  @@schema("public")
}

enum Gender {
  male
  female

  @@map("gender")
  @@schema("public")
}

enum CodeStatus {
  not_sent
  sent
  delivered
  failed

  @@map("code_status")
  @@schema("public")
}

/// Stored on voter_participation only, never on ballots.
enum VoteChannel {
  web
  ussd
  kiosk

  @@map("vote_channel")
  @@schema("public")
}

enum ChoiceKind {
  contester
  yes
  no
  skipped

  @@map("choice_kind")
  @@schema("public")
}

enum TieOutcome {
  contester
  no_winner

  @@map("tie_outcome")
  @@schema("public")
}

/// Message templates (Backend Schema 7.1): organization defaults (event_id NULL) and event
/// overrides; without a row the built-in Swahili default applies. One per type and channel.
model SmsTemplate {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  eventId        String?        @map("event_id") @db.Uuid
  type           MessageType
  channel        MessageChannel
  language       String         @default("sw")
  subject        String?
  body           String
  updatedBy      String?        @map("updated_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  event VotingEvent? @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, type, channel], map: "sms_templates_org_default_key", where: raw("event_id IS NULL"))
  @@unique([eventId, type, channel], map: "sms_templates_event_key", where: raw("event_id IS NOT NULL"))
  @@index([organizationId])
  @@map("sms_templates")
  @@schema("public")
}

/// One send action (Backend Schema 7.2): its audience, status and counters.
model SmsBatch {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  type           MessageType
  channel        MessageChannel
  audience       BatchAudience
  status         BatchStatus    @default(queued)
  totalCount     Int            @default(0) @map("total_count")
  sentCount      Int            @default(0) @map("sent_count")
  deliveredCount Int            @default(0) @map("delivered_count")
  failedCount    Int            @default(0) @map("failed_count")
  pausedReason   String?        @map("paused_reason")
  createdBy      String?        @map("created_by") @db.Uuid
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  event    VotingEvent  @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator  User?        @relation("BatchCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  messages SmsMessage[]

  @@index([eventId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@index([createdBy])
  @@map("sms_batches")
  @@schema("public")
}

/// Each SMS or email (Backend Schema 7.3). The voting code is never stored: body_redacted has
/// it as ••••-••••; the worker decrypts the code only to send.
model SmsMessage {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  eventId           String         @map("event_id") @db.Uuid
  batchId           String?        @map("batch_id") @db.Uuid
  voterId           String?        @map("voter_id") @db.Uuid
  channel           MessageChannel
  type              MessageType
  toAddress         String         @map("to_address")
  bodyRedacted      String         @map("body_redacted")
  providerMessageId String?        @unique @map("provider_message_id")
  status            MessageStatus  @default(queued)
  attempts          Int            @default(0) @db.SmallInt
  lastError         String?        @map("last_error")
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(6)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  event          VotingEvent     @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  batch          SmsBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  voter          Voter?          @relation(fields: [voterId], references: [id], onDelete: SetNull)
  kioskCodeSends KioskCodeSend[]

  @@index([batchId, status])
  @@index([voterId, createdAt(sort: Desc)])
  @@index([eventId])
  @@index([organizationId])
  @@map("sms_messages")
  @@schema("public")
}

enum MessageType {
  code_delivery
  reminder_before_open
  voting_open
  reminder_before_close
  vote_confirmation
  results_published
  event_cancelled
  event_extended

  @@map("message_type")
  @@schema("public")
}

enum MessageChannel {
  sms
  email

  @@map("message_channel")
  @@schema("public")
}

enum MessageStatus {
  queued
  sent
  delivered
  failed

  @@map("message_status")
  @@schema("public")
}

enum BatchAudience {
  all
  not_sent
  failed
  not_voted
  single

  @@map("batch_audience")
  @@schema("public")
}

enum BatchStatus {
  queued
  sending
  paused
  completed
  cancelled

  @@map("batch_status")
  @@schema("public")
}

enum ImportStatus {
  uploaded
  validated
  importing
  completed
  failed
  abandoned

  @@map("import_status")
  @@schema("public")
}

enum ReportType {
  results_pdf
  voters_pdf
  voters_xlsx
  audit_xlsx

  @@map("report_type")
  @@schema("public")
}

enum JobStatus {
  queued
  running
  completed
  failed

  @@map("job_status")
  @@schema("public")
}

/// Uploaded and generated files (Backend Schema 7.6). The bytes live under STORAGE_DIR at
/// storage_path and are served only through GET /api/v1/files/:id. Rows are never updated.
model File {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           FileKind
  /// Relative to STORAGE_DIR, e.g. org/{orgId}/contester_photo/{uuid}.jpg.
  storagePath    String   @unique @map("storage_path")
  originalName   String?  @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  width          Int?
  height         Int?
  sha256         String   @db.Char(64)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator           User?          @relation("FileCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  logoOf            Organization[] @relation("OrganizationLogo")
  pictureOf         Category[]     @relation("CategoryPicture")
  photoOfContesters Contester[]    @relation("ContesterPhoto")
  photoOfVoters     Voter[]        @relation("VoterPhoto")
  voterImports      VoterImport[]

  @@index([organizationId])
  @@index([createdBy])
  @@map("files")
  @@schema("public")
}

/// CSV voter imports (Backend Schema 7.7, App Flow 6.6): the uploaded file, the validation
/// result (counters and row problems) and the import itself. Rows are inserted at confirm.
model VoterImport {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  fileId         String?      @map("file_id") @db.Uuid
  status         ImportStatus @default(uploaded)
  totalRows      Int          @default(0) @map("total_rows")
  validRows      Int          @default(0) @map("valid_rows")
  warningRows    Int          @default(0) @map("warning_rows")
  errorRows      Int          @default(0) @map("error_rows")
  /// [{row, field, code, severity}]: no voter data, only where and what.
  errors         Json         @default("[]")
  columnMapping  Json?        @map("column_mapping")
  /// Voters inserted at confirm.
  importedRows   Int          @default(0) @map("imported_rows")
  failureReason  String?      @map("failure_reason")
  createdBy      String?      @map("created_by") @db.Uuid
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  event   VotingEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  file    File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  creator User?       @relation("ImportCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([organizationId])
  @@index([fileId])
  @@index([createdBy])
  @@map("voter_imports")
  @@schema("public")
}

enum FileKind {
  org_logo
  category_picture
  contester_photo
  voter_photo
  csv_import
  report

  @@map("file_kind")
  @@schema("public")
}

enum ActorType {
  user
  voter
  system

  @@map("actor_type")
  @@schema("public")
}

// -----------------------------------------------------------------------------------------------
// Audit log (Backend Schema 7.8). Append-only: vk_api may only INSERT and SELECT, and triggers
// reject UPDATE, DELETE and TRUNCATE for everyone (migration 004). No foreign keys, so the
// history survives deleted users and events. Written only through AuditService.record().
// -----------------------------------------------------------------------------------------------

model AuditLog {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// NULL for platform actions.
  organizationId String?   @map("organization_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  /// No FK, so history survives user deletion.
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  /// Name and email at the time, or "System", or "Voter".
  actorLabel     String    @map("actor_label")
  eventId        String?   @map("event_id") @db.Uuid
  /// Dotted key, usually the permission used, e.g. event.publish.
  action         String
  /// Table name.
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  /// Changed columns only, after redaction.
  before         Json?
  after          Json?
  reason         String?
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_log")
  @@schema("audit")
}

// Backend Schema 6.1: who has voted, per category. Written only by app.cast_ballot(); never
// updated or deleted. No link to the ballot tables: that missing link is the secret ballot.
model VoterParticipation {
  voterId        String      @map("voter_id") @db.Uuid
  categoryId     String      @map("category_id") @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  channel        VoteChannel
  votedAt        DateTime    @map("voted_at") @db.Timestamptz(6)

  voter    Voter    @relation(fields: [voterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category Category @relation(fields: [categoryId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)

  @@id([voterId, categoryId])
  @@index([eventId, categoryId])
  @@index([organizationId])
  @@map("voter_participation")
  @@schema("public")
}

// Backend Schema 6.2: one row per submission. Only the event and the hour: no organization,
// voter, code, channel, device or exact time. Reachable only through app.cast_ballot() and
// app.tally_event(); vk_api has no access to the ballot schema.
model Ballot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  receivedHour DateTime @map("received_hour") @db.Timestamptz(6)

  event      VotingEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  selections BallotSelection[]

  @@map("ballots")
  @@schema("ballot")
}

// Backend Schema 6.3: the choices of a ballot. contester_id is NULL only for "skipped".
model BallotSelection {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ballotId    String     @map("ballot_id") @db.Uuid
  categoryId  String     @map("category_id") @db.Uuid
  contesterId String?    @map("contester_id") @db.Uuid
  choice      ChoiceKind

  ballot    Ballot     @relation(fields: [ballotId], references: [id], onDelete: Restrict)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contester Contester? @relation(fields: [contesterId], references: [id], onDelete: Restrict)

  // NULLS NOT DISTINCT is added in the migration SQL (Prisma cannot express it).
  @@unique([ballotId, categoryId, contesterId], map: "ballot_selections_ballot_category_contester_key")
  @@index([categoryId, contesterId])
  @@map("ballot_selections")
  @@schema("ballot")
}

// Backend Schema 7.4: a device running kiosk mode for one event. The token in the device URL is
// stored only as its SHA-256; the staff PIN only as Argon2id.
model KioskSession {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  deviceLabel    String    @map("device_label")
  tokenHash      Bytes     @unique @map("token_hash")
  pinHash        String    @map("pin_hash")
  launchedBy     String    @map("launched_by") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  endedBy        String?   @map("ended_by") @db.Uuid

  event     VotingEvent     @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  launcher  User            @relation("KioskLauncher", fields: [launchedBy], references: [id], onDelete: Restrict)
  ender     User?           @relation("KioskEnder", fields: [endedBy], references: [id], onDelete: Restrict)
  codeSends KioskCodeSend[]

  @@unique([id, organizationId], map: "kiosk_sessions_id_organization_id_key")
  @@index([eventId])
  @@index([organizationId])
  @@map("kiosk_sessions")
  @@schema("public")
}

// Backend Schema 7.5: each code sent from a kiosk. The other phone (KSK-03a) is kept only as an
// HMAC, for the 3-voters-per-number limit, and its last 3 digits for the audit log.
model KioskCodeSend {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  eventId             String   @map("event_id") @db.Uuid
  kioskSessionId      String   @map("kiosk_session_id") @db.Uuid
  voterId             String   @map("voter_id") @db.Uuid
  usedAlternatePhone  Boolean  @map("used_alternate_phone")
  alternatePhoneHmac  Bytes?   @map("alternate_phone_hmac")
  alternatePhoneLast3 String?  @map("alternate_phone_last3") @db.Char(3)
  smsMessageId        String?  @map("sms_message_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event   VotingEvent  @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session KioskSession @relation(fields: [kioskSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  voter   Voter        @relation(fields: [voterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  message SmsMessage?  @relation(fields: [smsMessageId], references: [id], onDelete: SetNull)

  @@index([eventId, alternatePhoneHmac])
  @@index([kioskSessionId])
  @@index([organizationId])
  @@map("kiosk_code_sends")
  @@schema("public")
}
