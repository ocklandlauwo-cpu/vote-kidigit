exports[`results report HTML matches the snapshot (English, not yet published) 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Election results · Uchaguzi Mkuu 2027</title>
<style>
@page { size: A4; margin: 16mm 14mm 18mm; }
* { box-sizing: border-box; }
html { font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 11pt; line-height: 1.45; color: #161D24; }
body { margin: 0; }
h1 { font-size: 18pt; margin: 0 0 2pt; font-weight: 600; }
h2 { font-size: 13pt; margin: 0 0 4pt; font-weight: 600; }
p { margin: 0; }
.muted { color: #4C5864; }
.small { font-size: 9pt; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; font-size: 8.5pt; word-break: break-all; }
header.report { display: flex; align-items: center; gap: 12pt; padding-bottom: 8pt;
  border-bottom: 2pt solid #0B6A8A; margin-bottom: 12pt; }
header.report img { max-height: 48pt; max-width: 120pt; }
dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 2pt 12pt; margin: 0 0 12pt; }
dl.facts dt { color: #4C5864; }
dl.facts dd { margin: 0; }
section.category { break-inside: avoid; border: 0.75pt solid #D6DDE3; border-radius: 4pt;
  padding: 8pt 10pt; margin-bottom: 10pt; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-weight: 600; font-size: 9pt; color: #4C5864;
  border-bottom: 0.75pt solid #B8C3CC; padding: 3pt 4pt; }
td { padding: 3pt 4pt; border-bottom: 0.5pt solid #E9EDF1; vertical-align: top; }
thead { display: table-header-group; }
tr { break-inside: avoid; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.winner { font-weight: 600; }
.badge { display: inline-block; font-size: 8.5pt; font-weight: 600; color: #166534;
  border: 0.75pt solid #15803D; border-radius: 3pt; padding: 0 3pt; }
.warn { color: #B91C1C; }
.notes { margin-top: 4pt; font-size: 9pt; color: #4C5864; }
.signatures { break-inside: avoid; margin-top: 16pt; }
.signatures .lines { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14pt; margin-top: 8pt; }
.signatures .line { border-top: 0.75pt solid #36414B; padding-top: 3pt; margin-top: 28pt;
  font-size: 9pt; color: #4C5864; }
.verify { break-inside: avoid; display: flex; gap: 12pt; align-items: center; margin-top: 16pt;
  padding-top: 8pt; border-top: 0.75pt solid #D6DDE3; }
.verify svg { width: 84pt; height: 84pt; flex: none; }
</style>
</head>
