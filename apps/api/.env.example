# Every variable the API and worker read (Tech Stack 10, plus Backend Schema 13.5).
# Validated with Zod at startup: the process refuses to start if any required value is missing
# or malformed, and in production if any value still starts with CHANGE_ME.
# Development: scripts/dev-db-setup.sh writes apps/api/.env from this file with local values.

# --- App ---
NODE_ENV=development            # development | test | production
PORT=3000
APP_URL=https://votekidigit.co.tz
PROCESS_ROLE=api                # api | worker (set by PM2 per process)
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# --- Database ---
# Application role: RLS always applies, no access to ballots
DATABASE_URL=postgresql://vk_api:CHANGE_ME@127.0.0.1:5432/vote_kidigit
# Owner role: used only by prisma migrate deploy
MIGRATION_DATABASE_URL=postgresql://vk_owner:CHANGE_ME@127.0.0.1:5432/vote_kidigit

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# --- Security ---
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
BALLOT_TOKEN_SECRET=CHANGE_ME_64_RANDOM_CHARS
# 64 random bytes as hex (128 characters): HMAC-SHA256 fingerprint of voting codes
CODE_HMAC_KEY=CHANGE_ME
# 32 random bytes as base64: AES-256-GCM copy of voting codes for re-sending
CODE_ENCRYPTION_KEY=CHANGE_ME
# Header secret for GET /api/health/live-events (deploy safety check)
DEPLOY_HEALTH_SECRET=CHANGE_ME
SESSION_IDLE_MINUTES=15
VOTER_IDLE_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- NextSMS ---
NEXTSMS_BASE_URL=CHANGE_ME      # from NextSMS API documentation
NEXTSMS_USERNAME=CHANGE_ME
NEXTSMS_PASSWORD=CHANGE_ME
NEXTSMS_DEFAULT_SENDER_ID=CHANGE_ME
NEXTSMS_DLR_SECRET=CHANGE_ME    # shared secret checked on delivery-report callbacks

# --- USSD (aggregator to be chosen) ---
USSD_SHORT_CODE="*XXX#"         # quoted: an unquoted # starts a comment
USSD_CALLBACK_SECRET=CHANGE_ME

# --- Email (DirectAdmin SMTP) ---
SMTP_HOST=mail.votekidigit.co.tz
SMTP_PORT=587
SMTP_USER=no-reply@votekidigit.co.tz
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="Vote-Kidigit <no-reply@votekidigit.co.tz>"

# --- Storage ---
STORAGE_DIR=/home/vk/storage
MAX_UPLOAD_MB=2
MAX_CSV_MB=10

# --- Monitoring ---
SENTRY_DSN=
