{
  "name": "@vote-kidigit/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, types, permission keys, constants, design tokens and sw/en strings shared by the API and both apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design/tokens.css": "./src/design/tokens.css",
    "./design/fonts/*": "./src/design/fonts/*"
  },
  "files": [
    "dist",
    "src/design/tokens.css",
    "src/design/fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "vitest": "4.1.12"
  }
}
