{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // No DOM types: src/ is compiled by the API too; browser code goes through globalThis.
    "lib": ["ES2023"],
    // Node types for vite-plugin-design.ts only; src/ never imports node: modules.
    "types": ["node"]
  },
  "include": ["src", "vite-plugin-design.ts"]
}
